# Required
PRIVATE_KEY=
RPC_HTTPS=https://api.mainnet-beta.solana.com
RPC_WSS=wss://api.mainnet-beta.solana.com

# Safety: keep true until you have verified quotes and tx construction
DRY_RUN=true

# Size / risk
SLIPPAGE=10
TOKEN_AMOUNT=0.05
MAX_POSITIONS=3
MAX_SOL_PER_TRADE=0.2
MAX_DAILY_LOSS_SOL=0.5

# Snipe exits
TP=2.0
SL=0.5
TRAILING_STOP_PCT=0.2
TIME_EXCEED=90

# Snipe filters
COPY_WALLETS=
MIN_LIQUIDITY_SOL=0.5
SKIP_IF_MINT_AUTHORITY=true

# Arbitrage
ARB_ENABLED=true
ARB_MIN_PROFIT_SOL=0.005
ARB_AMOUNT_SOL=0.25
ARB_INTERVAL_MS=500
ARB_PAIRS=SOL-USDC,SOL-USDT

# Execution
USE_JITO=true
JITO_BLOCK_ENGINE_URL=https://ny.mainnet.block-engine.jito.wtf
JITO_TIP_VALUE=0.0001
UNIT_PRICE=1000
UNIT_LIMIT=400000

# Optional HTTP proxy for Raydium API
# HTTP_PROXY=http://127.0.0.1:7890
